# Copy this file to .env.local and fill in real values. .env.local is gitignored —
# never put real credentials in this .example file, since it IS committed to git.

# MongoDB connection string for the admin login + editable site content.
# Local:  mongodb://localhost:27017/zehran-portfolio
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>
MONGODB_URI=

# Long random string used to sign admin session tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Cloudinary account used to host admin-uploaded images (certifications,
# Selected Work thumbnails). Find these under Dashboard > Account Details at
# https://console.cloudinary.com — all three are required for uploads to work.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
